---
import { hubLinks } from './radar-hub.mjs';
interface Props { lang?: 'zh' | 'en' }
const { lang = 'zh' } = Astro.props;
const zh = lang === 'zh';
---
<section id="radar" class="radar-section wrap" aria-labelledby="radar-title" data-radar-hub data-radar-lang={lang}>
  <div class="radar-copy">
    <p class="eyebrow">DAILY SIGNAL / WEEKLY PERSPECTIVE</p>
    <h2 id="radar-title">{zh ? '保持好奇。' : 'Stay curious.'}<br /><span class="gradient-text">{zh ? '每天都有新发现。' : 'Find something new.'}</span></h2>
    <p>{zh ? '发现新的开源项目，追踪真实的 Star 变化，把值得细读的内容留到下一次。' : 'Discover open source, follow real Star changes, and save worthwhile reading for later.'}</p>
    <div class="radar-links"><a class="pill-button" href={hubLinks.home} target="_blank" rel="noopener noreferrer">{zh ? '打开技术雷达' : 'Explore Tech Radar'}<span aria-hidden="true">↗</span></a><a class="radar-rss" href={hubLinks.rss}>{zh ? '订阅 RSS' : 'Subscribe via RSS'} ↗</a></div>
    <a class="radar-source" href="https://github.com/leeeway/daily-trend-radar" target="_blank" rel="noopener noreferrer">{zh ? '在 GitHub 查看这个项目' : 'View the project on GitHub'} ↗</a>
  </div>
  <article class="radar-preview" aria-labelledby="radar-brief-title">
    <div class="radar-card-top"><span class="eyebrow">LATEST SIGNAL</span><span class="radar-status" data-radar-status>{zh ? '每日采集 · 每周回顾' : 'DAILY / WEEKLY'}</span></div>
    <div class="radar-signal" aria-hidden="true"><span></span><span></span><span></span><i>✳</i><b></b></div>
    <p class="radar-date" data-radar-date>{zh ? '技术雷达' : 'TECH RADAR'}</p>
    <h3 id="radar-brief-title"><a data-radar-latest href={hubLinks.home} target="_blank" rel="noopener noreferrer">{zh ? '读一点，想远一点。' : 'A little reading. A wider view.'}</a></h3>
    <p class="radar-card-description">{zh ? '开源项目、开发者热议与严重安全公告。自动汇编，保留原始来源。' : 'Open-source projects, developer conversations and critical security advisories. Automatically compiled with source links. Briefs are in Chinese.'}</p>
    <div class="radar-card-actions"><a data-radar-read href={hubLinks.home} target="_blank" rel="noopener noreferrer">{zh ? '阅读日报' : 'Read the brief'} ↗</a><a data-radar-weekly href={hubLinks.home} target="_blank" rel="noopener noreferrer">{zh ? '查看周报' : 'Weekly review'} ↗</a></div>
    <p class="radar-update-note" data-radar-note aria-live="polite">{zh ? '每日持续更新，点击查看完整归档。' : 'Updated regularly. Explore the complete archive.'}</p>
  </article>
  <div class="radar-hub" aria-label={zh ? '技术雷达快捷入口' : 'Tech Radar shortcuts'}>
    <a class="radar-feature" data-radar-discoveries href={hubLinks.discoveries} target="_blank" rel="noopener noreferrer">
      <span class="radar-feature-eyebrow">01 / DISCOVER</span><h3>{zh ? '新增发现' : 'New discoveries'}<span aria-hidden="true">↗</span></h3>
      <strong data-radar-new-count>{zh ? '打开本期新发现' : 'Explore new entries'}</strong>
      <p data-radar-new-detail>{zh ? '只看在本站归档中首次出现的内容。' : 'See entries appearing in this archive for the first time.'}</p>
      <small data-radar-new-period>{zh ? '随最新一期自动更新' : 'Updated with the latest issue'}</small>
    </a>
    <a class="radar-feature radar-feature-growth" data-radar-growth href={hubLinks.growth} target="_blank" rel="noopener noreferrer">
      <span class="radar-feature-eyebrow">02 / FOLLOW</span><h3>{zh ? 'Star 增长榜' : 'Star growth'}<span aria-hidden="true">↗</span></h3>
      <strong>{zh ? '7 日变化，真实采样' : '7 days. Real snapshots.'}</strong>
      <p>{zh ? '比较最新一期项目的七日增量，展开曲线查看历史明细。' : 'Compare seven-day gains from the latest issue, with dated charts and samples.'}</p>
      <small>{zh ? '仅比较具备相隔七天采样的项目' : 'Requires snapshots taken seven days apart'}</small>
    </a>
    <article class="radar-feature radar-feature-reading">
      <span class="radar-feature-eyebrow">03 / KEEP READING</span><h3><a data-radar-reading href={hubLinks.reading} target="_blank" rel="noopener noreferrer">{zh ? '阅读工作台' : 'Reading workspace'}<span aria-hidden="true">↗</span></a></h3>
      <strong data-radar-library-count>{zh ? '收藏、待读、随时接着看' : 'Save. Read. Pick up later.'}</strong>
      <p>{zh ? '管理未读与收藏，通过备份恢复把阅读记录带到另一台设备。' : 'Manage unread and saved entries. Move reading records between devices with backups.'}</p>
      <a class="radar-queue-link" data-radar-queue href={hubLinks.saved} target="_blank" rel="noopener noreferrer">{zh ? '打开收藏待读列表' : 'Open saved reading queue'} ↗</a>
    </article>
  </div>
  <p class="radar-reading-note">{zh ? '阅读工作台在雷达站新标签页打开；同一浏览器可继续使用已有收藏和已读记录。' : 'The workspace opens on Tech Radar in a new tab. Use the same browser to continue with your saved and read records.'}</p>
</section>
<script>
  import { refreshHub } from './radar-hub.mjs';
  document.querySelectorAll<HTMLElement>('[data-radar-hub]').forEach(root => {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { observer.disconnect(); void refreshHub(root); }
      }, {rootMargin:'500px'});
      observer.observe(root);
    } else { void refreshHub(root); }
  });
</script>
<style>
.radar-section{display:grid;grid-template-columns:1fr 1fr;gap:32px 64px;align-items:center;padding-block:20px 100px}
.radar-copy>.eyebrow{color:var(--blue,#0669ed);margin-bottom:22px;font-size:10px}.radar-copy h2{font-size:clamp(32px,3.7vw,50px);line-height:1.2}.radar-copy>p:not(.eyebrow){color:#57708c;font-size:14px;line-height:1.9;margin-top:24px;max-width:390px}
.radar-links{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:28px}.radar-rss,.radar-source{font-size:11px;color:#456c98;line-height:1.7}.radar-source{display:inline-block;margin-top:20px}
.radar-preview{min-width:0;background:linear-gradient(135deg,#f1f8ff,#e7f2ff 80%,#e9eefd);border:1px solid #dce9f8;border-radius:28px;padding:30px;overflow:hidden}.radar-card-top{display:flex;align-items:center;justify-content:space-between;gap:14px}.radar-card-top .eyebrow{font-size:9px;color:#456c98}.radar-status{font-size:9px;color:#496c94;padding:5px 9px;border-radius:20px;background:#ffffffaa;white-space:nowrap}
.radar-signal{position:relative;height:75px;width:140px;margin:15px auto;display:grid;place-items:center}.radar-signal>span{position:absolute;width:64px;height:64px;border:1px solid #4b9df240;border-radius:50%;transform:rotateX(55deg) rotate(-20deg)}.radar-signal>span:nth-child(2){width:104px;height:104px}.radar-signal>span:nth-child(3){width:146px;height:146px}.radar-signal>i{z-index:1;width:49px;height:49px;border:1px solid white;border-radius:15px;background:linear-gradient(135deg,#fff,#d8edff);box-shadow:0 9px 22px #2579ca21;display:grid;place-items:center;color:#117aec;font-size:34px;font-style:normal}.radar-signal>b{position:absolute;right:12px;top:29px;height:7px;width:7px;border:2px solid white;background:#2294ed;border-radius:50%}
.radar-date{font-size:11px;letter-spacing:.08em;color:#4b7dac}.radar-preview h3{font-size:clamp(21px,2.2vw,29px);line-height:1.35;margin-top:11px}.radar-preview h3 a{overflow-wrap:anywhere}.radar-card-description{font-size:12px;line-height:1.9;color:#5b7694;margin-top:14px}.radar-card-actions{display:flex;justify-content:space-between;gap:15px;padding-top:18px;margin-top:22px;border-top:1px solid #5289ba23}.radar-card-actions a{font-size:12px;font-weight:550;color:#1769be;min-height:32px}.radar-update-note{font-size:10px;color:#6482a0;line-height:1.7;margin-top:10px;min-height:16px}
.radar-hub{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:6px}.radar-feature{display:flex;flex-direction:column;min-width:0;border:1px solid #dce9f8;border-radius:22px;padding:25px;background:#f2f8ff;transition:transform .2s,box-shadow .2s}.radar-feature-growth{background:#fff5e9;border-color:#f3e3cd}.radar-feature-reading{background:#f1f0fc;border-color:#e4e1f5}.radar-feature-eyebrow{font-size:8px;letter-spacing:.1em;color:#557797}.radar-feature h3{font-size:22px;line-height:1.35;letter-spacing:-.04em;margin:18px 0 15px}.radar-feature h3 span{float:right;font-size:16px;color:#527ca4}.radar-feature h3 a{display:block}.radar-feature strong{font-size:12px;font-weight:600;line-height:1.7}.radar-feature p{color:#57708c;font-size:12px;line-height:1.9;margin:10px 0 18px;overflow-wrap:anywhere}.radar-feature small,.radar-queue-link{font-size:10px;line-height:1.7;color:#527ca4;margin-top:auto}.radar-queue-link{color:#0669ed;align-self:flex-start;padding-block:5px}a.radar-feature:hover{transform:translateY(-3px);box-shadow:0 10px 25px #172b4709}.radar-reading-note{grid-column:1/-1;font-size:10px;line-height:1.8;color:#647c97;margin-top:-10px}
@media(max-width:1000px){.radar-section{gap:28px 30px}.radar-feature{padding:20px}.radar-feature h3{font-size:19px}}
@media(max-width:700px){.radar-section{grid-template-columns:1fr;gap:28px;padding-block:20px 64px}.radar-copy h2{font-size:36px}.radar-preview{padding:24px;border-radius:24px}.radar-hub{grid-template-columns:1fr;gap:14px}.radar-feature{padding:23px}.radar-feature h3{font-size:23px;margin-top:12px}.radar-feature p{margin-bottom:14px}.radar-links{gap:16px}.radar-reading-note{margin-top:-8px}}
@media(max-width:480px){.radar-copy h2{font-size:32px}}@media(prefers-reduced-motion:reduce){.radar-feature{transition:none}a.radar-feature:hover{transform:none}}
</style>
